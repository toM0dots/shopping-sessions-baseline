  "builder_dockerfile": "# The fast engine is Linux amd64 only. Other platforms still build the C++\n# engine below and receive an empty fast-engine directory.\nFROM rust:1.100.0-alpine AS fast-builder\nRUN apk add --no-cache musl-dev\nWORKDIR /src\nCOPY fast/Cargo.toml fast/Cargo.lock ./\nCOPY fast/.cargo .cargo\nCOPY fast/src src\nCOPY fast/LICENSE /usr/share/doc/shopping-sessions-fast/LICENSE\nENV XL_INLINE_PURCHASE=1\nRUN mkdir -p /fast-bin \\\n    && if [ \"$(uname -m)\" = x86_64 ]; then \\\n        cargo build --locked --release --target x86_64-unknown-linux-musl \\\n        && cp target/x86_64-unknown-linux-musl/release/pipeline /fast-bin/shopping-sessions-fast; \\\n    fi\n\n# Build at image-build time, never inside the timed execution. Unused Arrow\n# components are excluded; the native binary links Arrow/Parquet statically.\n\nRUN test -s /fast-bin/shopping-sessions-fast && test -x /fast-bin/shopping-sessions-fast\n",
  "rust_config": "[build]\n# PKU is unused and can be masked on otherwise compatible virtual CPUs.\n# Keep this feature contract synchronized with pipeline/dispatch.cpp.\nrustflags = [\"-C\", \"target-cpu=cascadelake\", \"-C\", \"target-feature=-pku\", \"-C\", \"relocation-model=static\", \"-C\", \"llvm-args=-x86-branches-within-32B-boundaries\", \"-C\", \"llvm-args=-x86-pad-max-prefix-size=5\"]\n",
